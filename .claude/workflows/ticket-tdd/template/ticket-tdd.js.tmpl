export const meta = {
  name: 'ticket-tdd',
  description: 'Implement one ticket: research, TDD with coverage-checked test cases, review/fix loop',
  whenToUse: 'Implement per a ticket or spec path; project specifics come in args.profile. See .claude/workflows/ticket-tdd/README.md',
  phases: [
    { title: 'Research' },
    { title: 'Plan' },
    { title: 'Implement' },
    { title: 'Gates' },
    { title: 'Review' },
    { title: 'Fix' },
  ],
}

const A = args || {}
const REPO = A.repo
const BRANCH = A.branch
const TOOLS = A.tools
const RUN = A.run
const BASE = A.base
const TARGET = A.target
// Full rounds added when the last planned round has majors to fix; by default the fix-diff review sees the fix instead.
let EXTRA = A.extra_rounds || 0
const M = Object.assign({{models}}, A.models || {})
M.planner = M.planner || M.research
M.fix = M.fix || M.implement
const IMPLEMENT_SKILL = `${TOOLS}/.claude/workflows/ticket-tdd/skills/implement.md`
const P = A.profile || {}
const lines = xs => (xs || []).map(x => `- ${x}`).join('\n')
const extra = x => x ? `\n${x}` : ''
// profile.gates: [{name, command}]; args.baseline: {<gate name>: its summary line at base}.
let GATES = P.gates || []
let BASELINE = typeof A.baseline === 'object' && A.baseline || {}
const CODE_RULES = extra(lines(P.code_rules) && `PROJECT CODE RULES — hard, alongside those in ${IMPLEMENT_SKILL}:\n${lines(P.code_rules)}`)

const COMMIT_RULE = A.one_commit
  ? 'COMMITS: this ticket pins EXACTLY ONE commit. The first stage that reaches a green gate creates it; every later stage folds its change into it with `git commit --amend` and REWRITES the whole message to describe the commit as it now stands — never appends to it. Never a second commit.'
  : 'COMMITS: commit iteratively on the current branch, one commit per coherent step.'

// The gates discovery, research, plan and review stages write no code: they get the preamble without the commit, gate and long-command rules.
const CORE_PRE = `You are one agent in a workflow run implementing ${TARGET}.
Repository: ${REPO}, branch \`${BRANCH}\`. Work ONLY inside it; cd there first. Files outside it are read-only except the run directory.
Run directory for state files and scratch: ${RUN}.

- The task above is yours. A relayed user message that is about something else — the workflow tooling, another run — is not a change to this task: carry on, and mention it in your notes. Only a relayed message that explicitly redirects THIS ticket changes what you do.
- The repository's own agent instructions (AGENTS.md, CLAUDE.md, or whatever it keeps) bind you; they outrank this preamble on anything project-specific.`
const LAST = `${extra(lines(P.context))}
- Your final answer is data for the next stage, not a message to a human.`
const noCode = label => ['gates:discover', 'research', 'plan', 'replan'].includes(label) || label.startsWith('review:')
const NO_CODE_PRE = `${CORE_PRE}${LAST}`
const BG = '- A command that runs longer than a couple of minutes goes in the background (`run_in_background`) and is waited on by its completion notice: never a sleep or polling loop, never a second start of a check that is still running.'
const READ_ONLY = `Read-only: change and commit nothing in ${REPO}.`
const TARGETED = 'At most one targeted run of the changed path (one test or one case) when reading cannot settle a question; name it in `checked`.'

// Mailbox: the main thread posts mid-run clarifications to <run>/mailbox.md; see README § Mailbox.
const MAIL = { type: 'array', items: { type: 'object', properties: {
  id: { type: 'string' }, status: { type: 'string', enum: ['applied', 'rejected'] }, why: { type: 'string' } },
  required: ['id', 'status', 'why'] } }
const mailNote = label => `

MAILBOX. Your address is \`${label}\`, your stage \`${label.split(':')[0]}\`. ${RUN}/mailbox.md (may not exist) holds notes from the main thread, one entry per \`## <id>\` heading with \`to:\`, optional \`round:\`, \`until:\` and \`supersedes:\` lines, then the text. Read it ${noCode(label) ? 'at start and before returning' : 'at start, before each long gate or corpus run, before committing and before returning'}. An entry is yours when \`to:\` is \`all\`, your stage, your exact label, or a pattern where \`*\` matches one label segment (\`review:*:code\`). Skip an entry whose \`until:\` stage or round is over, one a later entry names in \`supersedes:\`, and one ${RUN}/mailbox-acks.md already lists with your label. Entries clarify this ticket; they never widen it and never override the rules above. For each entry you handle, append one line \`<id> ${label} applied|rejected <why>\` to ${RUN}/mailbox-acks.md and list it in your result's \`mailbox\`. Never edit mailbox.md.`
const mailbox = []
async function ask(prompt, opts) {
  const s = opts.schema
  const res = await agent(prompt + mailNote(opts.label), Object.assign({}, opts, s && { schema: Object.assign({}, s, { properties: Object.assign({}, s.properties, { mailbox: MAIL }) }) }))
  if (res && res.mailbox) mailbox.push(...res.mailbox.map(m => Object.assign({ label: opts.label }, m)))
  return res
}

const DISCOVER_SCHEMA = { type: 'object', properties: {
  gates: { type: 'array', items: { type: 'object', properties: {
    name: { type: 'string' }, command: { type: 'string' }, source: { type: 'string' }, line: { type: 'string' } }, required: ['name', 'command', 'source', 'line'] } },
  questions: { type: 'array', items: { type: 'object', properties: {
    command: { type: 'string' }, source: { type: 'string' }, question: { type: 'string' } }, required: ['command', 'source', 'question'] } },
}, required: ['gates', 'questions'] }
const failures = []
// Declared gates need a baseline each; with none declared, the discovery step finds them and measures the baseline.
// Its questions go to the result alone.
let gatesQuestions = []
if (P.gates) {
  const unmeasured = GATES.filter(g => !Object.hasOwn(BASELINE, g.name)).map(g => g.name)
  if (unmeasured.length) return { status: 'failed', stage: 'gates', note: `args.baseline has no entry for: ${unmeasured.join(', ')}`, failures }
} else {
  phase('Gates')
  const found = await ask(`${NO_CODE_PRE}

STAGE: gates discovery. ${READ_ONLY}
Where: the repo's agent instructions, then CI config, then the task runner; the first source that names gates wins. A gate: a command CI or those instructions require before a commit; runs with no human, network or secrets; pass/fail by exit code; writes nothing to the tree.
Run each gate exactly as its \`command\` reads, once, to completion; one that cannot run that way here is a question, not a gate. gates: name, command (the exact command line), source (the file that names it), line (its summary line verbatim, with the cause of any failure). questions: each command you are unsure of (is it a gate, do two sources disagree), with \`source\` the source of the gate it bears on; it stays out of gates.
${BG}`,
    { model: M.gates, effort: 'medium', schema: DISCOVER_SCHEMA, phase: 'Gates', label: 'gates:discover' })
  if (!found || !found.gates.length) return { status: 'failed', stage: 'gates:discover', note: found ? 'no gate found' : 'the discovery step died', gates_questions: found ? found.questions : [], failures }
  GATES = found.gates
  BASELINE = Object.fromEntries(GATES.map(g => [g.name, g.line]))
  gatesQuestions = found.questions.filter(q => GATES.some(g => g.source === q.source) || log(`gates question from unknown source ${q.source}: dropped`))
}

const gateList = sep => GATES.map(g => `${g.name}: \`${g.command}\` (baseline: ${BASELINE[g.name]})`).join(sep)
const PRE = `${CORE_PRE}
- ${COMMIT_RULE} Stage explicit paths only — never \`git add -A\` or \`git add .\`. Commit messages describe the change, not the run (no "round", no stage names)${P.commit ? `; ${P.commit}` : ''}. Commit only with the gate at its baseline or better.
- Gates: ${gateList('; ')}. Each baseline was measured before the run (re-measure, never quote). "Green" means no gate worse than its baseline.
- You do not edit ${TARGET} or the other ticket files.
${BG}
- Over-built output is a finding, not a bonus.${LAST}`

const RESEARCH_SCHEMA = { type: 'object', properties: {
  requirements: { type: 'array', items: { type: 'string', pattern: '^R\\d+: ' } },
  facts: { type: 'array', items: { type: 'object', properties: {
    kind: { type: 'string', enum: ['code', 'change-site', 'note'] }, fact: { type: 'string' },
    where: { anyOf: [{ type: 'array', items: { type: 'string' }, minItems: 1 }, { type: 'string' }] },
    requirements: { type: 'array', items: { type: 'string' }, minItems: 1 },
  }, required: ['kind', 'fact', 'where', 'requirements'] } },
  plan: { type: 'array', items: { type: 'string', maxLength: 600 } },
  test_harness: { type: 'array', items: { type: 'object', properties: {
    requirement: { type: 'string' }, by: { type: 'string', enum: ['test', 'review', 'launch', 'none'] }, how: { type: 'string' },
  }, required: ['requirement', 'by', 'how'] } },
  questions: { type: 'array', items: { type: 'object', properties: {
    requirement: { type: 'string' }, question: { type: 'string' }, settles: { type: 'string', enum: ['owner', 'outside'] },
  }, required: ['requirement', 'question', 'settles'] } },
}, required: ['requirements', 'facts', 'plan', 'test_harness', 'questions'] }

// A case names its requirement by id, one of the ids the planner is given.
const casesSchema = ids => ({ type: 'object', properties: { cases: { type: 'array', items: { type: 'object', properties: {
  id: { type: 'string' }, requirement: { type: 'string', enum: ids }, title: { type: 'string' },
  arrange: { type: 'string' }, act: { type: 'string' }, asserts: { type: 'array', items: { type: 'string' } },
}, required: ['id', 'requirement', 'title', 'arrange', 'act', 'asserts'] } },
  questions: { type: 'array', items: { type: 'object', properties: {
    requirement: { type: 'string' }, question: { type: 'string' }, reading: { type: 'string' },
    cases: { type: 'array', items: { type: 'string' } }, settles: { type: 'string', enum: ['research', 'owner'] },
  }, required: ['requirement', 'question', 'reading', 'cases', 'settles'] } } }, required: ['cases', 'questions'] })

const IMPL_SCHEMA = { type: 'object', properties: {
  committed: { type: 'boolean' },
  head: { type: 'string' },
  commits: { type: 'array', items: { type: 'string' } },
  tests: { type: 'array', items: { type: 'object', properties: { case_id: { type: 'string' }, file: { type: 'string' }, test: { type: 'string' } }, required: ['case_id', 'file', 'test'] } },
  gate_output: { type: 'string' },
  unverified: { type: 'array', items: { type: 'string' } },
  notes: { type: 'string' },
}, required: ['committed', 'head', 'commits', 'tests', 'gate_output', 'unverified'] }

const FINDING = { type: 'object', properties: {
  severity: { type: 'string', enum: ['major', 'minor'] },
  where: { type: 'string' }, problem: { type: 'string' },
  trigger: { type: 'string' }, consequence: { type: 'string' }, fix: { type: 'string' },
  proof: { type: 'object', properties: { path: { type: 'string' }, command: { type: 'string' }, red: { type: 'string' } }, required: ['path', 'command', 'red'] },
}, required: ['severity', 'where', 'problem', 'trigger', 'consequence', 'fix'] }
const reviewSchema = row => ({ type: 'object', properties: {
  verdict: { type: 'string', enum: ['clean', 'findings'] },
  findings: { type: 'array', items: FINDING },
  checked: { type: 'array', items: { type: 'object', properties: Object.assign({ item: { type: 'string' }, evidence: { type: 'string' } }, row), required: ['item', 'evidence'].concat(Object.keys(row)) } },
  notes: { type: 'string' },
}, required: ['verdict', 'findings', 'checked'] })
const STATUS = { status: { type: 'string', enum: ['met', 'unmet', 'unverified'] } }
const REVIEW_SCHEMA = reviewSchema({})
const PRODUCTION = 'production source (only tests, docs, data or config)'

const SURVIVOR = { type: 'object', properties: { file: { type: 'string' }, line: { type: 'integer' }, op: { type: 'string' }, before: { type: 'string' }, after: { type: 'string' } }, required: ['file', 'line', 'op', 'before', 'after'] }
const GATES_SCHEMA = { type: 'object', properties: {
  head: { type: 'string' },
  gates: { type: 'array', items: { type: 'object', properties: {
    name: { type: 'string', enum: GATES.map(g => g.name) }, status: { type: 'string', enum: ['green', 'red', 'not_run'] }, line: { type: 'string' },
  }, required: ['name', 'status', 'line'] } },
  notes: { type: 'string' },
}, required: ['head', 'gates'] }
const MUTATION_SCHEMA = { type: 'object', properties: {
  head: { type: 'string' },
  tool: { type: 'object', properties: {
    applies: { type: 'boolean' }, ran: { type: 'boolean' }, not_run: { type: 'string' },
    generated: { type: 'integer' }, judged: { type: 'integer' }, killed: { type: 'integer' }, invalid: { type: 'integer' }, timeouts: { type: 'integer' },
    survivors: { type: 'array', items: SURVIVOR },
  }, required: ['applies', 'ran'] },
  notes: { type: 'string' },
}, required: ['head', 'tool'] }

const SEVERITY = `SEVERITY. major: a concrete defect in this diff, with a \`trigger\` (a reachable input or path that shows it) and a \`consequence\` (what breaks). minor: everything else — wording, style, a future risk, "one more test would be nice"; report at most two minors, one sentence each. A missing test is major only when you name the behaviour this diff adds, why the existing tests miss it, and the input that shows it. One root cause is one finding. After your first finding, make one more pass on a different concern before you stop. An empty list is a valid answer.`
// what: the rows' subject; none when the job already says what a row is.
const CHECKED = what => `In \`checked\`, ${what ? `one row per ${what}: \`item\`, and in \`evidence\`` : '`evidence` is'} one sentence naming the file, test or command output that settled it. A bare "ok" is not evidence. verdict is \`clean\` exactly when findings is empty. A review with no checked rows is read as no review.`
const idOf = s => s.split(':')[0].trim()
function silence(res, ids) {
  if (!res.checked.length) return 'no checked rows'
  if ((res.verdict === 'clean') !== !res.findings.length) return `verdict ${res.verdict} with ${res.findings.length} findings`
  const seen = new Set(res.checked.map(c => idOf(c.item)))
  const missing = (ids || []).filter(i => !seen.has(i))
  return missing.length ? `not checked: ${missing.join(', ')}` : null
}
// A major with no trigger is a minor; a lens keeps at most two minors.
function tidy(findings) {
  let minors = 0
  const out = findings.map(f => f.severity !== 'minor' && !(f.trigger || '').trim() ? Object.assign({}, f, { severity: 'minor', downgraded: true }) : f)
  const kept = out.filter(f => f.severity !== 'minor' || ++minors <= 2)
  const down = out.filter(f => f.downgraded).length
  if (down || kept.length < out.length) log(`findings tidied: ${down} downgraded for no trigger, ${out.length - kept.length} minors dropped`)
  return kept
}

const FIX_SCHEMA = { type: 'object', properties: {
  applied: { type: 'array', items: { type: 'object', properties: { id: { type: 'string' }, what: { type: 'string' } }, required: ['id', 'what'] } },
  rejected: { type: 'array', items: { type: 'object', properties: { id: { type: 'string' }, argument: { type: 'string' } }, required: ['id', 'argument'] } },
  proofs: { type: 'array', items: { type: 'object', properties: { id: { type: 'string' }, path: { type: 'string' }, outcome: { type: 'string', enum: ['rewritten', 'deleted'] } }, required: ['id', 'path', 'outcome'] } },
  committed: { type: 'boolean' },
  head: { type: 'string' },
  gate_output: { type: 'string' },
}, required: ['applied', 'rejected', 'proofs', 'committed', 'head', 'gate_output'] }
// Only the code lens proves a finding. Each proof is a fix's to rewrite or delete; one no fix accounts for is a stray.
const proofs = []
const settled = new Set()
const strayProofs = []
const stray = f => { settled.add(f.id); strayProofs.push({ id: f.id, path: f.proof.path }) }
// A proof from another source is not sent to a fix, but its file may exist: it is a stray, never dropped silently.
function proven(f) {
  if (f.proof && f.source !== 'code') { stray(f); delete f.proof }
  if (f.proof) proofs.push(f)
  return f
}
const reconcile = (sent, res) => sent.filter(f => f.proof && !settled.has(f.id))
  .forEach(f => res.proofs.some(p => p.id === f.id || p.path === f.proof.path) ? settled.add(f.id) : stray(f))


phase('Research')
const research = await ask(`${NO_CODE_PRE}

STAGE: research. Read ${TARGET}, its parent spec and the sections it names, sibling tickets, the documents they cite, and the code and tests the ticket touches. Collect the knowledge of the code that must be known BEFORE writing it: helpers and seams to reuse, every call site and reader affected, and the traps that apply. Every fact is shown by lines of code, a repository document or a read-only search of the repository. The baseline and the gates step own the environment and the checks' results: report neither in facts nor in plan.${extra(P.research)}

Output: JSON only; the one file you write is a mailbox ack.
- requirements: every checkable requirement, one line each, prefixed with its id R1, R2, … in order and naming the checklist box or phrase it comes from, e.g. "R7: grammar/effects.json holds 8 entries (Checklist › Whitelist)". Cover every checklist box.
- facts: one list, complete: every place the diff will touch, and every caller or reader of a symbol it changes. Each fact is one sentence with a kind, where, and requirements: the ids (e.g. "R7") it serves, at least one; a fact that serves the whole ticket and no requirement in particular (a shared convention, helper or harness) takes "general" instead. The kind follows one rule: lines of code show the fact → change-site when the change touches those lines, code otherwise; no lines of code show it → note.
  - code and change-site: where = a list of locations, each \`file\` or \`file:a-b\` (repository-relative, one range per entry; a fact spanning several files or ranges lists each one). A change-site fact says what is there now; a new file is named in the fact and located by an existing place it relates to.
  - note: where = one string, \`path § section\` (a repository document; the ticket's own spec only for a decision the requirement lines do not carry) or \`$ command\` (a read-only rg, grep, git, find or ls of the repository). A tool's behaviour is shown from the tree (its source, config or lock file).
- plan: the fewest actions that meet the requirements, built from the facts, in dependency order: reuse what the facts name before adding anything new, and add nothing the requirements do not ask for. Every step changes code, config or docs; running checks, committing and recording results belong to the implementer and the gates. Each step is two or three sentences: a part of the code (a module, config, script, doc set) and what is done to it, naming every tool, symbol and file it acts on; line ranges, flags, commands and lists stay in the facts.
- test_harness: exactly one entry per requirement: requirement (its id), by (test, review, launch or none), how (test: the seam and where its tests live; review or launch: what is checked; none: why). The run commands stay in the gates.
- questions: every point a requirement depends on that the repository does not settle, one entry each: requirement (its id), question, settles (owner: the ticket and the spec leave it to their author; outside: the answer lies outside the repository, in running the program, outside documentation or data). An empty list says nothing was left open.`,
  { model: M.research, effort: 'high', schema: RESEARCH_SCHEMA, phase: 'Research', label: 'research' })
if (!research) return { status: 'failed', stage: 'research', failures }
// The research checks: ids renumbered R1..Rn when one is missing or repeated, facts that serve no listed id dropped,
// one test_harness entry per requirement, files derived from the located facts. What they repair or cannot repair is
// reported in research_issues, not failures: the run goes on as before.
const researchIssues = []
if (research.requirements.some((r, i, all) => !/^R\d+:/.test(r) || all.findIndex(x => idOf(x) === idOf(r)) !== i)) {
  research.requirements = research.requirements.map((r, i) => `R${i + 1}: ${r.replace(/^R\d+:\s*/, '')}`)
  researchIssues.push('a requirement id was missing or repeated: renumbered R1..Rn')
}
const reqIds = research.requirements.map(idOf)
const serves = f => f.requirements.some(i => idOf(i) === 'general' || reqIds.includes(idOf(i)))
const droppedFacts = research.facts.filter(f => !serves(f))
research.facts = research.facts.filter(serves)
const cited = new Set(research.facts.flatMap(f => f.requirements.map(idOf)))
const unresearched = research.requirements.filter(r => !cited.has(idOf(r)))
research.test_harness.filter(h => !reqIds.includes(idOf(h.requirement))).forEach(h => researchIssues.push(`test_harness entry for unknown requirement ${h.requirement}: dropped`))
reqIds.forEach(id => {
  const n = research.test_harness.filter(h => idOf(h.requirement) === id).length
  if (n !== 1) researchIssues.push(n ? `${n} test_harness entries for ${id}: kept the first` : `no test_harness entry for ${id}`)
})
research.test_harness = reqIds.map(id => research.test_harness.find(h => idOf(h.requirement) === id)).filter(Boolean)
// Research questions go to the result alone: what research could not settle is not passed on as knowledge.
const researchQuestions = (research.questions || []).filter(q => reqIds.includes(idOf(q.requirement)) || !researchIssues.push(`question for unknown requirement ${q.requirement}: dropped`))
delete research.questions
research.files = [...new Set(research.facts.filter(f => f.kind !== 'note').flatMap(f => [].concat(f.where).map(w => w.split(':')[0].trim())))]
const RESEARCH = JSON.stringify(research, null, 1) + `

Start from the change-site facts above: read only the lines you change or verify, and search only for what they do not cover.`
let N = A.rounds && A.rounds !== 'auto' ? A.rounds : 2
// A run reviews its planned rounds in full even when the first is clean: round 2 catches majors round 1 missed.
const MIN_ROUNDS = A.min_rounds || Math.min(N, 2)
const LENS_KEYS = {{lenses}}
log(`research: ${research.requirements.length} requirements, ${droppedFacts.length} facts dropped, ${unresearched.length} unresearched -> ${N} review rounds, lenses ${LENS_KEYS.join(' + ')}`)

phase('Plan')
// Research's test_harness routes each requirement: test gets cases; review, none and no entry go to the checklist lens
// alone; launch leaves the run, listed in the result with research's how.
const harnessOf = id => research.test_harness.find(h => idOf(h.requirement) === id) || { by: 'review' }
const lineOf = id => research.requirements.find(r => idOf(r) === id)
const testIds = reqIds.filter(id => harnessOf(id).by === 'test')
const checkIds = reqIds.filter(id => harnessOf(id).by !== 'launch')
const PLAN_RULES = `cases: one case for each behaviour that ${testIds.join(', ')} name, their boundaries and rejections included. Each case goes through the seam its requirement's test_harness \`how\` names; every case is one test, and \`requirement\` is the id of the one requirement it checks. Each check lives in one case: a behaviour two requirements share is checked once, under the requirement that names it most directly. A case tests behaviour, not implementation: what a caller of the seam sees (inputs, outputs, effects, errors) and the stubs Arrange allows. How the test is written and run, and the code's inner structure (helpers, private names, call order), are the implementer's.
AAA — Arrange: every input and object the case uses, written out in this case; the case runs the real code, and a stub stands in only for what a test cannot run (another program, the network, hardware, the clock), each stub with what it is given and what it returns or writes; Act: ONE call through the seam; asserts: atomic, one expected value or one property each, on what the Act leaves visible to a caller.
The ticket and the spec are the oracle: each expected value is a single literal taken from them, never recomputed the way the code would, and a default or precedence they leave open takes the reading their words support, stated in the case.
questions: every point the ticket and the research leave open that a case still depends on, one entry each: requirement (its id), question, reading (the one the cases take), cases (the ids of the cases that take it), settles (research: the repository holds the answer and the research does not give it; owner: the ticket and the spec leave it to their author). An empty list says nothing was left open.
`

// With no test requirement there is nothing to plan: no planner call, no cases.
let plan = !testIds.length ? { cases: [] } : await ask(`${NO_CODE_PRE}

STAGE: test-case planning. No code is written yet.

${PLAN_RULES}

RESEARCH:
${RESEARCH}`, { model: M.planner, effort: 'high', schema: casesSchema(testIds), phase: 'Plan', label: 'plan' })
if (!plan) return { status: 'failed', stage: 'plan', failures }

// Coverage: every test requirement is cited by at least one case.
const coverage = p => testIds.filter(id => !p.cases.some(c => idOf(c.requirement) === id))
// Duplicates: the same check after the same Arrange and Act in two cases (case and whitespace folded).
const norm = s => s.toLowerCase().replace(/\s+/g, ' ').trim()
function duplicates(p) {
  const seen = {}
  p.cases.forEach(c => c.asserts.forEach(a => { const k = `${norm(c.arrange)} | ${norm(c.act)} | ${norm(a)}`; (seen[k] = seen[k] || new Set()).add(c.id) }))
  return Object.entries(seen).filter(([, ids]) => ids.size > 1).map(([check, ids]) => ({ check, cases: [...ids] }))
}
let cov = coverage(plan)
let dup = duplicates(plan)
if (cov.length || dup.length) {
  plan = await ask(`${NO_CODE_PRE}

STAGE: test-case planning, the one replan.${cov.length ? ` Your cases below leave ${cov.join(', ')} uncovered: add cases for each.` : ''}${dup.length ? ` These checks sit in several cases after the same Arrange and Act; keep each in one case: ${JSON.stringify(dup)}.` : ''} Keep every other case as it is, same id.

${PLAN_RULES}

YOUR PREVIOUS CASES:
${JSON.stringify(plan.cases)}

RESEARCH:
${RESEARCH}`, { model: M.planner, effort: 'high', schema: casesSchema(testIds), phase: 'Plan', label: 'replan' }) || plan
  cov = coverage(plan)
  dup = duplicates(plan)
}
plan.verify_review = checkIds.filter(id => !testIds.includes(id)).map(lineOf)
plan.verify_launch = reqIds.filter(id => !checkIds.includes(id)).map(id => ({ requirement: lineOf(id), how: harnessOf(id).how }))
// A question is kept only when a case takes its reading.
const questions = (plan.questions || []).filter(q => q.cases.some(id => plan.cases.some(c => c.id === id)))
const cases = plan.cases.map(c => Object.assign({}, c, { requirement: lineOf(idOf(c.requirement)) }))
log(`plan: ${cases.length} cases, ${cov.length} uncovered, ${dup.length} duplicate checks, ${questions.length} questions (${(plan.questions || []).length - questions.length} tied to no case), ${plan.verify_review.length} verify-by-review, ${plan.verify_launch.length} verify-by-launch`)
const CASES = JSON.stringify(cases, null, 1)

phase('Implement')
const implementPrompt = retry => `${PRE}

STAGE: implementation.${retry ? ` A previous attempt at this stage produced NO change (HEAD still ${BASE}); its notes: ${JSON.stringify(retry)}. Implement the ticket now.` : ''} Read ${IMPLEMENT_SKILL} and follow it, with the tdd/ directory beside it, and its code rules.${CODE_RULES}
Take the cases one at a time, red then green. Use the research facts and plan; do not re-derive what they settle.

Before reporting, call what you built the way its consumer will — its real entry point, not the steps that built it — and feed it every input, mode and data file the ticket names. Anything you did not run that way, and every claim you did not test, goes in \`unverified\`, one line each with its cause (no tool, no data, no time, out of scope); an empty list claims you ran all of it.

Run the tests you write as you go; run the gates once, at the end, before you commit — not at the start, not before and after. ${A.one_commit ? 'Create the ONE commit when the gate is at baseline or better; if it cannot get there, do not commit and say exactly what is red.' : 'Commit as you go.'}

Report: committed, head (\`git rev-parse HEAD\`), commits (sha + subject), tests (case_id -> file + test name, one row per case implemented), unverified, gate_output (each gate's summary line, verbatim), notes.

CASES:
${CASES}

RESEARCH:
${RESEARCH}`
let impl = await ask(implementPrompt(null), { model: M.implement, effort: 'high', schema: IMPL_SCHEMA, phase: 'Implement', label: 'implement' })
const madeNothing = r => !r || (r.head.startsWith(BASE.slice(0, 7)) && !r.tests.length)
if (madeNothing(impl)) {
  log('implement produced nothing; retrying once')
  impl = await ask(implementPrompt(impl ? impl.notes || 'none' : 'agent died'), { model: M.implement, effort: 'high', schema: IMPL_SCHEMA, phase: 'Implement', label: 'implement:retry' })
  if (madeNothing(impl)) return { status: 'failed', stage: 'implement', note: 'two attempts produced no change; nothing was reviewed', research, cases, failures }
}
log(`implement: committed=${impl.committed}, ${impl.tests.length} tests mapped`)

const mutation = []

// The gates step runs once per HEAD, before the lenses, which get its lines. HEAD moves only when implement or a fix commits.
let headNow = impl.head
let gated = null
const same = (a, b) => !!a && !!b && (a.startsWith(b) || b.startsWith(a))
const ruled = new Map()
const keyOf = s => `${s.file}|${s.before}|${s.after}`
// A survivor the code lens ruled is a minor finding (advisory, outside tidy's cap); every other one is a major, made by the script, not a lens.
const survivorFindings = survivors => survivors.map(s => {
  const r = ruled.get(keyOf(s))
  return {
    id: s.id, key: keyOf(s), source: 'mutation', severity: r ? 'minor' : 'major', where: `${s.file}:${s.line}`,
    problem: `a mutant survives: ${s.op} (${s.before} -> ${s.after})${r ? `; ruled ${r.ruling}: ${r.reason}` : ''}`,
    trigger: `run the tests with ${s.file}:${s.line} changed to: ${s.after}`,
    consequence: 'no test fails, so a defect of that shape on this line ships unnoticed',
    fix: 'add or strengthen a test that fails on this mutant, or show that no test could tell it from the original'
  }
})

const RULING_SCHEMA = { type: 'object', properties: {
  rulings: { type: 'array', items: { type: 'object', properties: { id: { type: 'string' }, ruling: { type: 'string', enum: ['equivalent', 'unreachable'] }, reason: { type: 'string' } }, required: ['id', 'ruling', 'reason'] } },
}, required: ['rulings'] }
// The code lens rules on the survivors the gates step found; a ruling without a reason does not count.
async function ruleSurvivors(survivors, label) {
  const open = survivors.filter(s => !ruled.has(keyOf(s)))
  if (!open.length) return
  const res = await ask(`${NO_CODE_PRE}

STAGE: mutant ruling, code lens, HEAD ${headNow}. The mutation tool changed one line at a time in the lines this ticket changed, and no test failed on these mutants. Read the code and the tests and rule on each one only when you are sure: \`equivalent\` (no test could tell the mutant from the original) or \`unreachable\` (the mutated code cannot run in the product's use), with a one-line reason. Leave out any you cannot rule: each becomes a major finding for the fix stage. ${READ_ONLY}
SURVIVORS:
${JSON.stringify(open)}`, { model: M.review, effort: 'high', schema: RULING_SCHEMA, phase: 'Review', label })
  if (!res) { failures.push(`mutant ruling ${label}`); return }
  for (const r of res.rulings) {
    const s = open.find(x => x.id === r.id)
    if (s && (r.reason || '').trim()) ruled.set(keyOf(s), r)
  }
}

// The gates step only executes; the script turns its rows into findings and failures.
async function runGates(round, label, tag) {
  phase('Gates')
  const res = await ask(`${NO_CODE_PRE}

STAGE: gates, HEAD ${headNow}. ${READ_ONLY}
Run each gate below from ${REPO} to completion and compare it with its baseline. One row per gate: \`line\` its summary line verbatim; \`status\` \`green\` (at its baseline or better), \`red\` (worse) or \`not_run\` (\`line\` the reason).
GATES:
- ${gateList('\n- ')}
${BG}`, { model: M.gates, effort: 'medium', schema: GATES_SCHEMA, phase: 'Gates', label })
  if (!res) failures.push(`gates ${label}`)
  else headNow = res.head || headNow
  const rows = GATES.map(g => (res && res.gates.find(r => r.name === g.name)) || { name: g.name, status: 'not_run', line: res ? 'no row' : 'the gates step died' })
  if (res) rows.filter(r => r.status === 'not_run').forEach(r => failures.push(`gates ${label}: ${r.name} not run: ${r.line}`))
  const vs = r => `${r.line} (baseline: ${BASELINE[r.name]})`
  return { head: headNow, gates: rows, found: rows.filter(r => r.status === 'red').map(r => ({
    id: `G${round}${tag || ''}-${r.name}`, source: 'gates', severity: 'major', where: r.name, problem: vs(r), trigger: vs(r),
    consequence: 'the gate is worse than at base', fix: 'make the gate pass at its baseline or better' })) }
}

// The mutation tool runs once per run, on the HEAD the review rounds settled on, not in every round's gates step.
// Returns the survivors as findings: ruled ones minor, the rest major.
let mutated = false
async function runMutation() {
  mutated = true
  if (!P.mutation) return []
  phase('Gates')
  const res = await ask(`${PRE}

STAGE: mutation, HEAD ${headNow}. The gates already ran: run none of them. Change nothing in ${REPO} and commit nothing.
The project's mutation tool: ${P.mutation} This run's label for file names: mutation. tool.applies: whether \`git diff --name-only ${BASE}..HEAD\` lists files it covers. If it applies, run it once on this HEAD and report its counts and every survivor; if it applies and did not run, tool.ran is false and tool.not_run the reason — never a pass.`, { model: M.gates, effort: 'medium', schema: MUTATION_SCHEMA, phase: 'Gates', label: 'mutation' })
  if (!res) { failures.push('mutation'); return [] }
  if (res.tool.applies && !res.tool.ran) failures.push(`mutation tool not run: ${res.tool.not_run || 'no reason given'}`)
  if (res.tool.applies) mutation.push(res.tool)
  if (!res.tool.ran) return []
  const survivors = (res.tool.survivors || []).map((s, i) => Object.assign({ id: `M-${i + 1}` }, s))
  await ruleSurvivors(survivors, 'review:code:survivors')
  return survivorFindings(survivors)
}

const GATES_APART = gated => `The gates step already ran every gate and long check at this HEAD; review the diff and its rows below.
GATES:
${gated.gates.map(r => `${r.name}: ${r.status} — ${r.line}`).join('\n')}`

const LENSES = [
  { key: 'checklist', schema: reviewSchema(STATUS), job: () => `${READ_ONLY} Check every requirement id — ${checkIds.join(', ')} — against the diff \`git diff ${BASE}..HEAD\` and the files on disk${plan.verify_review.length ? `; these have no test and are checked only by you: ${JSON.stringify(plan.verify_review)}` : ''}. One \`checked\` row per id: item = the id, status \`met\` (evidence names the artifact that shows it holds), \`unmet\` (name the clause that fails) or \`unverified\` (you could not check it). An id without a row counts as unverified. An \`unmet\` row becomes a finding by itself; \`findings\` are for defects outside the requirements. Scope: a change the ticket does not call for is a finding.${impl.unverified.length ? ` Implementation said it did not test: ${JSON.stringify(impl.unverified)}; weigh each against the requirement it touches.` : ''}` },
  { key: 'code', schema: REVIEW_SCHEMA, job: () => `${READ_ONLY} The one exception is a proof: you may prove a major about behaviour with a test, written as a new, uncommitted file in the repository's test directory; \`proof\` is its path, the exact command and the output line that showed it red on HEAD. ${TARGETED} Read the code as code: would every new branch execute as intended${P.runtime ? ` in ${P.runtime}` : ''}, is every new assertion falsifiable, and do the ticket's "things most likely to be got wrong" hold. Also the rules of ${IMPLEMENT_SKILL} § Code rules. Over-built code is a finding.{{order}}${CODE_RULES}
{{test_case_review.code}}If the diff holds no ${PRODUCTION}, check one row saying so and stop.` },
]
async function runFix(round, toFix, label) {
  phase('Fix')
  return ask(`${PRE}

STAGE: fix, round ${round}. Read ${IMPLEMENT_SKILL} and follow it, code rules included.${CODE_RULES} For each finding: verify before you agree, verify before you disagree. A fix that does not fit the implementation is NOT applied: reject it with an argument that cites code, the ticket or the spec — it goes back to the reviewers. Never delete the thing a finding is about to silence it. Group the findings by root cause first and fix each cause once, not one finding at a time; for each cause, check whether the same failure can arrive by another path — a sibling caller, another writer of the same state — and close that path too.${toFix.some(f => f.proof) ? ' For a finding with a `proof`, run its `command` first: green on HEAD is a valid rejection ("proof green"); a red proof is rejected only with an argument against the test. Never leave a proof as written: rewrite it into the suite in its style and commit it, or delete it; report each in `proofs`.' : ''}${fixed.length ? ` A finding whose root cause appears in EARLIER FIXES twice already is not patched a third time: reject it with the argument "recurs after two fixes: needs a split or the user".` : ''} Re-run the gates; ${A.one_commit ? 'fold the change into the one commit with --amend, rewriting its message (create the commit if it does not exist yet and the gate is at baseline or better)' : 'commit'}. Report head: \`git rev-parse HEAD\` after your last change.

FINDINGS:
${JSON.stringify(toFix, null, 1)}
${fixed.length ? `\nEARLIER FIXES:\n${JSON.stringify(fixed)}\n` : ''}
RESEARCH:
${RESEARCH}`, { model: M.fix, effort: 'high', schema: FIX_SCHEMA, phase: 'Fix', label })
}

// The last round's fix, which no full round follows, is reviewed on its own diff: did it fix what it was given, did it break
// anything near it, did it weaken a test. Returns its findings, or null when the reviewer died.
let fixReviews = 0
async function fixReview(fromHead, given, label) {
  fixReviews += 1
  phase('Review')
  const res = await ask(`${NO_CODE_PRE}

STAGE: fix review, HEAD ${headNow}. A fix moved HEAD from ${fromHead}; no full review round follows it. Review its diff, \`git diff ${fromHead}..HEAD\`, and only that: (1) each finding it was given is fixed by the diff or rightly rejected; (2) the diff breaks nothing it touches — a sibling caller, another writer of the same state{{test_case_review.fix}}. ${READ_ONLY} The gates step checks this HEAD after you. ${TARGETED}
${SEVERITY}
${CHECKED('finding it was given, item = its id, then each other thing you verified')}
GIVEN:
${JSON.stringify(given.map(f => ({ id: f.id, where: f.where, problem: f.problem })))}

RESEARCH:
${RESEARCH}`, { model: M.review, effort: 'high', schema: REVIEW_SCHEMA, phase: 'Review', label })
  if (!res) { failures.push(`fix review ${label}`); return null }
  const quiet = silence(res)
  if (quiet) failures.push(`fix review ${label} silent: ${quiet}`)
  verdicts.push({ round: label, lens: 'fix review', verdict: quiet ? 'SILENT' : res.verdict, count: res.findings.length })
  return tidy(res.findings).map((f, k) => proven(Object.assign({ id: `F${fixReviews}-${k + 1}`, source: 'fix review' }, f)))
}

let rejections = []
const advisory = []
const fixed = []
const history = []
const verdicts = []
const rounds = []
const status = {}
let unfixed = []
let round = 0
while (round < N) {
  round += 1
  const fresh = !gated || !same(gated.head, headNow)
  const gatesStep = async () => {
    if (!fresh) return gated
    return runGates(round, `gates:r${round}`)
  }
  phase('Review')
  let fromHead = headNow
  const active = LENSES.filter(l => LENS_KEYS.includes(l.key))
  const past = history.length ? `\nEARLIER FINDINGS (a fixed one stays closed, also as a broader future risk; re-raise a rejected one only as a finding whose \`problem\` answers its \`argument\`):\n${JSON.stringify(history)}\n` : ''
  gated = await gatesStep()
  const lensResults = await parallel(active.map(l => () => ask(`${NO_CODE_PRE}

STAGE: review, round ${round} of at most ${N} — what you do not catch ships. Lens: ${l.key}. ${l.job()}
${GATES_APART(gated)}
Compare against the ticket, its spec, and the research plan below.
${SEVERITY}${round > 1 ? ' A major on code the last fix did not change says in `problem` why the earlier round could not see it.' : ''}
${CHECKED(l.key === 'checklist' ? null : 'new or changed function or branch in the diff, item = where it is, then each other thing you verified')}
${past}
RESEARCH:
${RESEARCH}`, { model: M.review, effort: 'high', schema: l.schema, phase: 'Review', label: `review:r${round}:${l.key}` })))

  const found = fresh ? gated.found.slice() : []
  let reviewed = true
  lensResults.forEach((res, i) => {
    const l = active[i]
    if (!res) { failures.push(`review r${round} ${l.key}`); verdicts.push({ round, lens: l.key, verdict: 'DIED' }); reviewed = false; return }
    const quiet = silence(res)
    if (quiet) { failures.push(`review r${round} ${l.key} silent: ${quiet}`); reviewed = false }
    verdicts.push({ round, lens: l.key, verdict: quiet ? 'SILENT' : res.verdict, count: res.findings.length })
    if (l.key === 'checklist') {
      const rows = {}
      res.checked.forEach(c => { rows[idOf(c.item)] = c })
      checkIds.forEach(id => { status[id] = rows[id] ? { status: rows[id].status, evidence: rows[id].evidence } : { status: 'unverified', evidence: 'no checked row' } })
      // unmet is fixed like any major; unverified only goes to the leftover list at the end.
      checkIds.filter(id => status[id].status === 'unmet').forEach(id => found.push({ id: `R${round}-${id}`, source: 'checklist', severity: 'major',
        where: research.requirements.find(r => idOf(r) === id), problem: status[id].evidence, trigger: status[id].evidence,
        consequence: 'the ticket requirement is not met', fix: 'meet the requirement' }))
    }
    found.push(...tidy(res.findings).map((f, k) => proven(Object.assign({ id: `R${round}-${l.key}-${k + 1}`, source: l.key }, f))))
  })
  let toFix = found.filter(f => f.severity !== 'minor')
  advisory.push(...found.filter(f => f.severity === 'minor'))
  if (lensResults.every(r => !r)) log(`round ${round}: every lens died — this round was NOT reviewed`)
  const bySeverity = s => found.filter(f => f.severity === s).length
  rounds.push({ round, major: bySeverity('major'), minor: bySeverity('minor'), gates: gated.gates })
  log(`round ${round}: ${toFix.length} to fix`)

  if (!reviewed) log(`round ${round}: a lens died or came back silent — not a clean round`)
  if (!toFix.length && reviewed && round >= MIN_ROUNDS) {
    if (mutated) break
    const late = await runMutation()
    toFix = late.filter(f => f.severity !== 'minor')
    advisory.push(...late.filter(f => f.severity === 'minor'))
    if (!toFix.length) break
    // Survivors get a fix and one more review round, without the tool.
    log(`mutation: ${toFix.length} survivors to fix`)
    if (round === N) N += 1
  }
  if (toFix.length && round === N && EXTRA > 0) {
    EXTRA -= 1
    N += 1
    log(`round ${round}: ${toFix.length} to fix in the last round, one more round reviews the fix`)
  }
  if (toFix.length) {
    fromHead = headNow
    const fix = await runFix(round, toFix, `fix:r${round}`)
    if (!fix) { failures.push(`fix r${round}`); unfixed = toFix; break }
    fixed.push(...fix.applied.map(a => Object.assign({ round }, a)))
    rounds[rounds.length - 1].applied = fix.applied.length
    rounds[rounds.length - 1].rejected = fix.rejected.length
    rejections = fix.rejected.map(r => Object.assign({}, toFix.find(f => f.id === r.id) || { id: r.id }, { argument: r.argument }))
    toFix.forEach(f => {
      const r = fix.rejected.find(x => x.id === f.id)
      history.push(Object.assign({ id: f.id, round, where: f.where, problem: f.problem, outcome: fix.applied.some(a => a.id === f.id) ? 'fixed' : 'rejected' }, r && { argument: r.argument }))
    })
    reconcile(toFix, fix)
    headNow = fix.head || headNow
  }
  if (round === N) {
    unfixed = rejections.slice()
    // The last round's fix gets a fix-diff review; its majors get one more fix and review, then are left over.
    if (toFix.length && !same(headNow, fromHead)) {
      let from = fromHead
      let given = toFix
      for (let pass = 0; ; pass++) {
        const late = await fixReview(from, given, `review:fix:r${round}${pass ? `:${pass}` : ''}`)
        if (!late) {
          unfixed.push(...given.map(f => Object.assign({}, f, { status: 'unverified', problem: `fixed in the last round, its review died: ${f.problem}` })))
          break
        }
        advisory.push(...late.filter(f => f.severity === 'minor'))
        const majors = late.filter(f => f.severity !== 'minor')
        if (!majors.length) break
        if (pass >= 1) { unfixed.push(...majors.map(f => Object.assign({}, f, { status: 'unverified' }))); break }
        from = headNow
        const again = await runFix(round, majors, `fix:r${round}:review`)
        if (!again) { failures.push(`fix r${round} review`); unfixed.push(...majors); break }
        fixed.push(...again.applied.map(a => Object.assign({ round }, a)))
        headNow = again.head || headNow
        given = majors
      }
    }
    if (!same(headNow, gated.head)) {
      // The last fix moved HEAD and no review follows: the gates step checks it.
      gated = await runGates(round, `gates:r${round}:recheck`, 'r')
      rounds[rounds.length - 1].recheck = gated.gates
      unfixed.push(...gated.found)
    }
  }
}
// A run that used up its rounds without a clean one still gets its one mutation run; its survivors are left over.
if (!mutated && !failures.some(f => f.startsWith('fix '))) {
  const late = await runMutation()
  unfixed.push(...late.filter(f => f.severity !== 'minor'))
  advisory.push(...late.filter(f => f.severity === 'minor'))
}
// A finding is the same finding by what it says, not by its positional id: a survivor by file, line text and mutated text,
// any other by source, place and problem (a rejection without a place by its id).
const sameKey = f => f.key || (f.where ? `${f.source}|${f.where}|${f.problem}` : f.id)
const uniq = xs => xs.filter((x, i) => xs.findIndex(y => sameKey(y) === sameKey(x)) === i)
const unmet = checkIds.filter(id => !status[id] || status[id].status !== 'met').map(id => ({
  id, source: 'checklist', where: research.requirements.find(r => idOf(r) === id), status: status[id] ? status[id].status : 'unverified',
  problem: status[id] ? status[id].evidence : 'the checklist lens never answered' }))

// Cheap minor findings get one pass of a cheaper fixer after the rounds; the ones it does not apply stay advisory.
// Ruled survivors are left out: their ruling says no test can tell them apart.
const cheap = uniq(advisory).filter(f => f.source !== 'mutation')
let minorFix = null
if (cheap.length && !failures.length) {
  phase('Fix')
  minorFix = await ask(`${PRE}

STAGE: minor fixes. Read ${IMPLEMENT_SKILL} and follow it, code rules included.${CODE_RULES} Apply each finding below whose fix is cheap: a few lines in files this run already changed, no new test file, no change of design. Reject every other one with a one-line reason; it stays advisory. Verify before you agree; never delete the thing a finding is about to silence it. Re-run the gates; if any gate is worse than before your edit, revert your edits and reject them all.${cheap.some(f => f.proof) ? ' Delete the file of every finding with a `proof`, applied or not, and report each in `proofs`.' : ''} ${A.one_commit ? 'Fold the change into the one commit with --amend, rewriting its message' : 'Commit'}. Report head: \`git rev-parse HEAD\` after your last change.

FINDINGS:
${JSON.stringify(cheap, null, 1)}`, { model: M.fix, effort: 'medium', schema: FIX_SCHEMA, phase: 'Fix', label: 'fix:minor' })
  if (!minorFix) failures.push('fix minor')
  else reconcile(cheap, minorFix)
}
// A proof no fix was sent (its fix died, the run stopped) is a stray too; strays count as failures only here, so
// one never skips the minor fix.
proofs.filter(f => !settled.has(f.id)).forEach(stray)
strayProofs.forEach(s => failures.push(`stray proof ${s.id}: ${s.path}`))
const minorApplied = f => !!minorFix && minorFix.applied.some(a => a.id === f.id)

// Freeing the run directory is the main thread's step after acceptance (README § Shape).
return {
  status: failures.length ? 'done_with_failures' : impl.unverified.length ? 'done_unverified' : 'done',
  rounds_planned: N,
  rounds_run: round,
  rounds,
  verdicts,
  mutation,
  uncovered_requirements: cov,
  dropped_facts: droppedFacts,
  unresearched_requirements: unresearched,
  plan_questions: questions,
  research_issues: researchIssues,
  research_questions: researchQuestions,
  gates: GATES,
  gates_questions: gatesQuestions,
  verify_launch: plan.verify_launch,
  verify_review: plan.verify_review,
  leftover_findings: uniq(unfixed.concat(unmet)),
  advisory: uniq(advisory).filter(f => !minorApplied(f)),
  minor_fixes: minorFix && { applied: minorFix.applied, rejected: minorFix.rejected },
  stray_proofs: strayProofs,
  unverified: impl.unverified,
  implement: { committed: impl.committed, commits: impl.commits, gate_output: impl.gate_output, notes: impl.notes },
  mailbox,
  failures,
}
